# Copia este archivo a .env y cambia los secretos. No uses estos valores en producción.

DATABASE_NAME=empleord
DATABASE_URL=jdbc:postgresql://localhost:5432/empleord
DATABASE_USER=empleord
DATABASE_PASSWORD=change-me

JWT_SECRET=change-me-to-a-random-string-with-32-bytes-min
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
FILE_SIGNING_SECRET=change-me-file-signing-secret-32bytes

PORT=8080
STORAGE_PATH=./data/uploads
CORS_ORIGINS=http://localhost:4200,http://localhost:8088
APP_PUBLIC_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
APP_PRODUCTION=false
JOB_DEFAULT_DAYS=30
SPRINGDOC_ENABLED=true

MAIL_ENABLED=false
MAIL_LOG_LINKS=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@empleord.do

# PayPal Subscriptions. Déjalo apagado hasta tener credenciales reales.
# No pongas secretos de producción en este archivo.
PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Google AdSense. Déjalo apagado hasta tener el Publisher ID real del sitio aprobado.
# Los identificadores son públicos. No pongas una clave secreta aquí.
ADSENSE_ENABLED=false
ADSENSE_PUBLISHER_ID=
ADSENSE_SLOT_HOME_TOP=
ADSENSE_SLOT_HOME_FEED=
ADSENSE_SLOT_JOB_SEARCH_INLINE=
ADSENSE_SLOT_JOB_DETAIL_BOTTOM=
ADSENSE_SLOT_CATEGORY_CONTENT=
ADSENSE_SLOT_INFO_CONTENT=
ADSENSE_SLOT_RESOURCE_CONTENT=
